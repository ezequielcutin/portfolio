#!/usr/bin/env bash
# Refuses a commit whose app.bundle.js does not match the JSX sources.
#
# app.bundle.js is committed rather than built in CI, so nothing else stops
# "edited .jsx, forgot to rebuild" from shipping stale code to production.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Only relevant when JSX is part of this commit.
if ! git diff --cached --name-only | grep -qE '\.jsx$'; then
  exit 0
fi

before="$(md5 -q app.bundle.js 2>/dev/null || echo none)"
node scripts/build.mjs >/dev/null
after="$(md5 -q app.bundle.js 2>/dev/null || echo none)"

if [[ "$before" != "$after" ]]; then
  cat <<'MSG'

  app.bundle.js was out of date and has been rebuilt.

  JSX changes are staged but the bundle was stale — committing would have
  shipped the old code. The rebuilt bundle and index.html are not staged.

    git add app.bundle.js index.html

  then commit again.

MSG
  exit 1
fi

exit 0
