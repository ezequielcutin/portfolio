#!/usr/bin/env bash
# Refuses a commit whose generated files do not match their sources:
# app.bundle.js against the JSX, and shaders.js against shaders/.
#
# Both are committed rather than built in CI, so nothing else stops
# "edited a source, forgot to rebuild" from shipping stale code.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# Only relevant when a build input is part of this commit.
if ! git diff --cached --name-only | grep -qE '\.jsx$|^shaders/'; then
  exit 0
fi

sum() { md5 -q "$1" 2>/dev/null || echo none; }

bundle_before="$(sum app.bundle.js)"
shaders_before="$(sum shaders.js)"
node scripts/build.mjs >/dev/null
bundle_after="$(sum app.bundle.js)"
shaders_after="$(sum shaders.js)"

if [[ "$bundle_before" != "$bundle_after" || "$shaders_before" != "$shaders_after" ]]; then
  cat <<'MSG'

  Generated files were out of date and have been rebuilt.

  Sources are staged but their build output was stale — committing would
  have shipped the old code. The rebuilt files are not staged.

    git add app.bundle.js shaders.js index.html

  then commit again.

MSG
  exit 1
fi

exit 0
